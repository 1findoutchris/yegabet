generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  AGENT
  AFFILIATE
  ADMIN
  SUPERADMIN
  // Retail betting cashier: a normal user account (wallet, deposits,
  // withdrawals) restricted to the sports UI, who places bets on behalf of
  // walk-in customers against printed Tickets. Created only from admin.
  IN_PERSON_AGENT
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET
  WIN
  BONUS
  COMMISSION
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum BetStatus {
  PENDING
  WON
  LOST
  CANCELLED
  CASHOUT
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  VIP
}

model User {
  id String @id @default(cuid())

  // The player-facing account number, quoted in support chats and printed on
  // the profile and admin screens. `id` is a cuid — unreadable over the phone —
  // and re-keying every foreign key to fix that is not worth it, so this is a
  // second, purely public identifier. Same reasoning as WithdrawalRequest.publicId.
  //
  // Random rather than sequential so it doesn't publish the signup count, and
  // generated by the DB so no code path can create a user without one.
  // ponytail: 9 digits = 900M values, and a clash just fails that one signup
  // (unique index). At 1M users that's a ~0.1% chance per signup; if it ever
  // shows up in the logs, retry the insert — the default re-rolls on each try.
  // The expression is written the way POSTGRES renders it back, not the way it
  // was typed in the migration: `floor()` returns double precision, so the
  // literal is coerced and stored with an explicit cast. The CI drift check
  // compares this string against the replayed migrations, so the two must match
  // character for character.
  // The cash agent this player last deposited with. While set (and that agent
  // is still active), cash withdrawals route back to them — the money went in
  // over their counter, so it comes out over the same one. Cleared by an admin,
  // and ignored entirely once the agent is deactivated, so a player is never
  // stranded behind an agent who has stopped working.
  cashAgentId String?
  accountNo   Int     @unique @default(dbgenerated("(((100000000)::double precision + floor((random() * (900000000)::double precision))))::integer"))

  phone        String  @unique
  email        String? @unique
  username     String  @unique
  name         String?
  passwordHash String
  role         Role    @default(USER)
  isActive     Boolean @default(true)
  isVerified   Boolean @default(false)

  // Telegram account linked through the VinnaBet bot (src/lib/tgLink.ts). Set
  // only after the bot received the user's OWN contact card (contact.user_id ==
  // sender) whose number matches `phone`. Unique so one Telegram account can
  // never sign into two VinnaBet accounts. Text, not BigInt: Telegram ids fit a
  // bigint, but Prisma's BigInt can't be JSON-serialised and several routes
  // return user rows as they are. Same choice as WithdrawalAgent.telegramChatId.
  telegramUserId          String?   @unique
  telegramUsername        String?
  telegramFirstName       String?
  telegramLinkedAt        DateTime?
  telegramPhoneVerifiedAt DateTime?

  // Total playable funds — the figure the game provider sees and settles against.
  // It is the sum of three pots:
  //   depositBalance — funded by deposits, playable but NOT withdrawable
  //   bonusBalance   — funded by bonuses,  playable but NOT withdrawable
  //   withdrawable   — won from gameplay, freely withdrawable
  // Withdrawable is derived, never stored: balance − depositBalance − bonusBalance.
  // A bet drains deposit → bonus → withdrawable; a win lands wholly in
  // withdrawable only if the round paid at least 1.1× the stake, otherwise it
  // returns to the pots that funded it. All of it lives in src/lib/wallet.ts.
  balance        Decimal @default(0) @db.Decimal(12, 2)
  depositBalance Decimal @default(0) @db.Decimal(12, 2)
  bonusBalance   Decimal @default(0) @db.Decimal(12, 2)

  loyaltyTier   LoyaltyTier @default(BRONZE)
  // Lifetime XP — drives tier, achievements and the all-time leaderboard. Never
  // decremented, so redeeming can't demote a player or revoke a badge.
  loyaltyPoints Int         @default(0)
  // Spendable points wallet. Incremented alongside loyaltyPoints (see awardPoints
  // in src/lib/loyalty.ts); the only counter a redemption debits.
  pointsBalance Int         @default(0)

  // Prize-wheel "coupons". Earned by referring a verified signup (see
  // SpinCreditGrant), spent one per spin. Same shape as pointsBalance: the
  // atomic compare-and-set on this column is what makes over-spend impossible.
  spinCredits Int @default(0)

  // Daily-login streak (My Casino)
  streakDays Int       @default(0)
  lastSeenAt DateTime?

  referralCode String? @unique
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")

  agentId     String?
  affiliateId String?
  agent       Agent?     @relation(fields: [agentId], references: [id])
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])

  // In-person betting agent (role = IN_PERSON_AGENT): percent of each bet's
  // stake earned as commission, set by admin. NULL for everyone else.
  commissionRate Decimal? @db.Decimal(5, 2)
  agentTickets   Ticket[]

  transactions       Transaction[]
  bets               Bet[]
  bonuses            UserBonus[]
  sessions           Session[]
  recentGames        RecentGame[]
  gameSessions       GameSession[]
  favoriteGames      FavoriteGame[]
  depositRequests    DepositRequest[]
  withdrawalRequests WithdrawalRequest[]
  pushSubscriptions  PushSubscription[]
  nativePushTokens   NativePushToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Web Push subscription — one row per device, so a user can receive
// notifications on multiple phones.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// Push token from the native iOS/Android app (APNs device token on iOS, FCM
// registration token on Android). Web Push doesn't work inside the app's
// WebView, so the app registers here instead of in push_subscriptions.
model NativePushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String // "ios" | "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("native_push_tokens")
}

model Agent {
  id             String  @id @default(cuid())
  userId         String  @unique
  code           String  @unique
  isActive       Boolean @default(true)
  commissionRate Int     @default(500)

  users    User[]
  deposits AgentDeposit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agents")
}

model Affiliate {
  id             String  @id @default(cuid())
  userId         String  @unique
  code           String  @unique
  isActive       Boolean @default(true)
  commissionRate Int     @default(300)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("affiliates")
}

model Transaction {
  id            String            @id @default(cuid())
  userId        String
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  amount        Decimal           @db.Decimal(12, 2)
  balanceBefore Decimal           @db.Decimal(12, 2)
  balanceAfter  Decimal           @db.Decimal(12, 2)
  reference     String            @unique @default(cuid())
  metadata      Json?

  user User @relation(fields: [userId], references: [id])

  // Set when this BET/WIN row was placed through an in-person agent's ticket.
  ticketBet TicketBet?
  // Public "Check Ticket" code for a player's sportsbook bet (see TicketCheckCode).
  checkCode TicketCheckCode?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Without these every reporting and per-player query seq-scans the table.
  @@index([type, status, createdAt])
  @@index([userId, type])
  @@map("transactions")
}

model Bet {
  id           String    @id @default(cuid())
  userId       String
  amount       Decimal   @db.Decimal(12, 2)
  potentialWin Decimal   @db.Decimal(12, 2)
  status       BetStatus @default(PENDING)
  odds         Float
  reference    String    @unique @default(cuid())
  metadata     Json?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bets")
}

model Bonus {
  id          String  @id @default(cuid())
  name        String
  description String?
  amount      Decimal @db.Decimal(12, 2)
  isActive    Boolean @default(true)
  minDeposit  Int     @default(0)
  wagerReq    Int     @default(1)

  userBonuses UserBonus[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bonuses")
}

model UserBonus {
  id        String  @id @default(cuid())
  userId    String
  bonusId   String
  amount    Int
  remaining Int
  isUsed    Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id])
  bonus Bonus @relation(fields: [bonusId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_bonuses")
}

model AgentDeposit {
  id        String  @id @default(cuid())
  agentId   String
  amount    Decimal @db.Decimal(12, 2)
  reference String  @unique
  smsData   Json?

  agent Agent @relation(fields: [agentId], references: [id])

  createdAt DateTime @default(now())

  @@map("agent_deposits")
}

model WithdrawalRequest {
  id             String    @id @default(cuid())
  userId         String
  amount         Decimal   @db.Decimal(12, 2)
  method         String
  account        String
  accountName    String
  status         String    @default("PENDING")
  adminNote      String?
  proofKey       String? // ETB: S3 key of the payment proof shown to the user
  proofExpiresAt DateTime? // proof hidden + deleted from bucket after this (2 days)

  // Short human-readable code (e.g. "W-3F9K2A") the admin quotes when asking a
  // payout agent why a request was delayed. Stable for the life of the row.
  publicId String? @unique

  // Reference of the PENDING Transaction reserving these funds. Settling by
  // reference rather than by (user, type, amount) is what stops two
  // same-amount withdrawals from closing each other's ledger row.
  txnReference String?

  // Payout agent (automatic ETB rail) this was routed to, and the clock.
  withdrawalAgentId String?
  assignedAt        DateTime? // SLA clock starts here
  processingAt      DateTime? // agent/admin locked it — the player can no longer cancel
  paidAt            DateTime? // marked paid; SLA measured against assignedAt

  user            User             @relation(fields: [userId], references: [id])
  withdrawalAgent WithdrawalAgent? @relation(fields: [withdrawalAgentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([withdrawalAgentId, status])
  @@map("withdrawal_requests")
}

model DepositRequest {
  id          String  @id @default(cuid())
  userId      String
  amount      Decimal @db.Decimal(12, 2)
  method      String
  receiptText String
  smsRef      String?
  status      String  @default("PENDING")
  adminNote   String?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("deposit_requests")
}

model RecentGame {
  id           String   @id @default(cuid())
  userId       String
  gameId       String
  playCount    Int      @default(1)
  lastPlayedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, gameId])
  @@index([userId, lastPlayedAt])
  @@map("recent_games")
}

// Provider game session (Gregmorn). openGame returns a sessionId which their
// wallet callbacks echo back as `sessionid` — we validate it here so a
// getBalance/writeBet for an unknown session is rejected, and so the session
// can stand in for roundId when a provider omits it.
model GameSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  userId    String
  gameId    String
  provider  String   @default("gregmorn")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("game_sessions")
}

model FavoriteGame {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, gameId])
  @@index([userId])
  @@map("favorite_games")
}

model AdminUser {
  id           String  @id @default(cuid())
  username     String  @unique
  passwordHash String
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

model AdminLog {
  id         String  @id @default(cuid())
  action     String
  targetId   String?
  targetType String?
  note       String?
  ipAddress  String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([action])
  @@index([targetId])
  @@map("admin_logs")
}

// Payout agents — they settle player withdrawals on the automatic (ETB) rail.
//
// Distinct from PaymentAgent (just the account numbers shown to players).
// A payout agent holds no float: they pay from their own funds, the
// platform records what it owes them plus commission, and it is settled later.
//
model WithdrawalAgent {
  id           String  @id @default(cuid())
  username     String  @unique // auto-generated at creation
  passwordHash String
  name         String?
  isActive     Boolean @default(true)

  // Withdrawal methods this agent can process, e.g. ["telebirr","cbebirr"].
  // Requests are only ever routed to an agent that handles their method.
  methods String[]

  // Percent of each processed withdrawal earned as commission, e.g. 3.00.
  commissionRate Decimal @default(0) @db.Decimal(5, 2)

  // Cash agents are the counter-service rail: they take cash from a walk-in
  // customer and credit that player's account, and they pay cash out against a
  // withdrawal code. Unlike the payout rail they spend a prepaid float, so they
  // can never credit a player with money they haven't handed over first.
  // An agent can be both — the two ledgers stay separate. See src/lib/agentLedger.ts.
  isCashAgent Boolean @default(false)

  // Largest single withdrawal this agent may be routed, in ETB. NULL = no cap,
  // which is how every agent created before this column behaves. Deliberately
  // never sent to the payout portal — the agent sees their queue, not the
  // ceiling that shaped it.
  maxWithdrawalEtb Decimal? @db.Decimal(12, 2)

  // Minutes allowed between assignment and payout before the request counts
  // as an SLA breach. Breaches are flagged and counted, never auto-actioned.
  slaMinutes Int @default(30)

  contactType   String? // "whatsapp" | "telegram"
  contactHandle String?

  // Telegram chat the bot pushes new requests to. Set by the agent logging in
  // through the bot, cleared by /logout. Unique so one chat can never be
  // listening on two agents' queues.
  telegramChatId String? @unique

  withdrawals    WithdrawalRequest[]
  ledger         WithdrawalAgentTxn[]
  payoutRequests AgentPayoutRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("withdrawal_agents")
}

// An agent asking to be paid what they're owed.
//
// Deliberately NOT a WithdrawalAgentTxn row: outstanding is the sum of
// PAYOUT + COMMISSION − SETTLEMENT, so a request sitting in that table would
// move the balance before anyone had sent a birr. The SETTLEMENT row is written
// only when an admin marks this PAID — same split as WithdrawalRequest and the
// player's ledger Transaction.
model AgentPayoutRequest {
  id      String  @id @default(cuid())
  agentId String
  amount  Decimal @db.Decimal(12, 2)

  // How the agent wants the money: rail, account number, name on the account.
  method      String
  account     String
  accountName String

  status    String    @default("PENDING") // PENDING | PAID | REJECTED
  adminNote String?
  paidAt    DateTime?

  agent WithdrawalAgent @relation(fields: [agentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([agentId, createdAt])
  @@map("agent_payout_requests")
}

// What the platform owes a payout agent, and the commission they've earned.
// There is no running balance column — the outstanding amount is the sum of
// PAYOUT + COMMISSION rows since the last SETTLEMENT.
model WithdrawalAgentTxn {
  id      String  @id @default(cuid())
  agentId String
  type    String // PAYOUT | COMMISSION | SETTLEMENT
  amount  Decimal @db.Decimal(12, 2)
  refId   String? // WithdrawalRequest id
  note    String?

  agent WithdrawalAgent @relation(fields: [agentId], references: [id])

  createdAt DateTime @default(now())

  @@index([agentId, type, createdAt])
  @@map("withdrawal_agent_txns")
}

model PaymentAgent {
  id          String @id // method id: telebirr | cbebirr | ebirr | uae_bank
  agentNumber String
  agentName   String

  // Kill switches, separate per direction: a rail can be down for deposits
  // while withdrawals still settle (or the reverse, when agent float runs out).
  // An absent row means enabled — see getMergedMethods.
  depositEnabled  Boolean @default(true)
  withdrawEnabled Boolean @default(true)

  // Amount limits in whole ETB. Defaults reproduce the constants the deposit
  // and withdraw routes used to hardcode — see src/lib/paymentLimits.ts.
  minDeposit  Int @default(50)
  maxDeposit  Int @default(100000)
  minWithdraw Int @default(50)
  maxWithdraw Int @default(100000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_agents")
}

// Admin kill switch per OTP handset. `id` is the gateway label ("1".."4"),
// derived from the SMSGATE_* env suffix — the handsets themselves stay in env,
// since their credentials are what route a message to a physical phone.
// An absent row means enabled, same rule as PaymentAgent, so a phone that has
// never been touched here keeps working.
model SmsDevice {
  id        String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("sms_devices")
}

// Admin-editable reward configuration. One row per block
// (pointsEconomy | streakMilestones | weeklyChallenges | tiers | achievements);
// `value` holds the whole block as JSON. Absent key = fall back to the code
// defaults in src/lib/rewardConfig.ts. See src/lib/paymentConfig.ts for the
// same "DB override over static defaults" pattern.
model RewardConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("reward_config")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@map("sessions")
}

// Image-only ads placed by admin. BOARD renders as a swipeable strip in the
// lobby; POPUP shows once per day over it. Expiry is the off switch that needs
// no admin action — `isActive` is the manual pause.
model Ad {
  id        String   @id @default(cuid())
  placement String // "BOARD" | "POPUP"
  imageKey  String // S3 object key, served via /api/ads/[id]/image
  linkUrl   String? // optional click-through
  expiresAt DateTime
  isActive  Boolean  @default(true)
  // Carousel position within a placement, ascending. Ties fall back to newest
  // first, which is how ordering worked before this column existed.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  // Cache-buster for the image. The S3 key is fixed per ad so a re-upload
  // overwrites in place, and the public image route caches for a day — without
  // this the old banner would stick around after an admin swapped it.
  updatedAt DateTime @updatedAt

  @@index([placement, isActive, expiresAt])
  @@map("ads")
}

// ── Prize wheel ───────────────────────────────────────────────────────────────
// Prizes live in a table rather than a RewardConfig JSON block because `stock`
// is mutable runtime state: setRewardConfig is a whole-blob upsert with a
// lost-update window, getRewardConfig is React-cached (deliberately stale), and
// the admin BLOCKS editor replaces the whole array. Any of the three would hand
// out the same physical prize twice.

model SpinPrize {
  id             String  @id @default(cuid())
  label          String
  // CASH → credits money · PHYSICAL → admin hands it over · SPIN → awards more
  // coupons · NONE → a "try again" wedge, so a loss has somewhere to land.
  kind           String // "CASH" | "PHYSICAL" | "SPIN" | "NONE"
  cashEtb        Decimal @default(0) @db.Decimal(12, 2)
  // Spin coupons awarded when kind = SPIN.
  creditsAwarded Int     @default(0)
  // Which pot a cash win lands in. "bonus" is playable-not-withdrawable (the
  // default everywhere else); "withdrawable" is real cash out the door.
  payoutPot      String  @default("bonus") // "bonus" | "withdrawable"
  // Win chance in basis points (10000 = 100%). Integer so the cumulative-sum
  // walk in spinCore is exact — no float drift across a long prize list.
  weightBps      Int     @default(0)
  // 0 = unwinnable regardless of chance. Always finite: a nullable "unlimited"
  // adds a branch to the atomic decrement, which is where such guards go wrong.
  stock          Int     @default(0)
  imageKey       String? // S3 key `prizes/<id>`, served via /api/rewards/prize/[id]/image
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("spin_prizes")
}

// One row per referral that ever earned spins. `refereeId @unique` IS the
// "one grant per referee, ever" anti-farm guard — a DB constraint, not app code.
model SpinCreditGrant {
  id         String   @id @default(cuid())
  referrerId String
  refereeId  String   @unique
  credits    Int
  createdAt  DateTime @default(now())

  @@index([referrerId, createdAt]) // the rolling 7-day cap count
  @@map("spin_credit_grants")
}

// Every spin, wins and losses alike. label/kind/cashEtb are SNAPSHOTS so a
// renamed or deleted prize doesn't rewrite history; prizeId is a breadcrumb,
// deliberately not a foreign key.
model SpinResult {
  id        String   @id @default(cuid())
  userId    String
  prizeId   String? // null = no win
  label     String
  kind      String // "CASH" | "PHYSICAL" | "NONE"
  cashEtb   Decimal  @default(0) @db.Decimal(12, 2)
  reference String   @unique // equals Transaction.reference for cash wins
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt]) // admin's physical-wins list
  @@map("spin_results")
}

// Admin-generated "rigged" link. The first person to sign up through it is
// guaranteed to win `prizeId` on their spin — single-use, so one link is one
// winner. There is deliberately no User.guaranteedPrizeId column: this row must
// exist anyway for the admin list, and a second copy of the same fact is two
// places to disagree, where disagreeing means a doubled or lost prize.
model SpinLink {
  id              String    @id @default(cuid())
  code            String    @unique
  prizeId         String // breadcrumb, deliberately NOT a foreign key
  prizeLabel      String // snapshot — survives the prize being renamed or deleted
  note            String? // admin's "who is this for"
  claimedByUserId String?
  claimedAt       DateTime?
  // Set to the winning SpinResult.reference. Does double duty: the atomic
  // consume-marker AND the audit pointer, so no second column is needed.
  fulfilledRef    String?

  createdAt DateTime @default(now())

  @@index([claimedByUserId])
  @@map("spin_links")
}

// ── In-person betting agent (retail cashier) ─────────────────────────────────
//
// A Ticket is the printed receipt a walk-in customer holds. The agent opens a
// draft (customer name + phone), places bets in the sportsbook iframe, and the
// wallet callback attaches each BET Transaction to the open ticket via
// TicketBet. When every bet on the ticket has settled the ticket is WON (any
// win) or LOST; the customer returns with the ticket, the agent pays cash and
// marks it PAID with an S3 receipt in proofKey.
//
// Money truth stays in Transaction — a ticket never moves funds, it only
// groups the agent's own BET/WIN rows under a customer-facing code.
model Ticket {
  id       String @id @default(cuid())
  // Short human-readable code the customer quotes at the counter ("T-3F9K2A").
  // Same reasoning as WithdrawalRequest.publicId.
  publicId String @unique
  agentId  String

  // OPEN    — draft; BET transactions attach while open
  // PLACED  — issued/printed; waiting for results
  // WON     — all bets settled, totalWin > 0 (customer is owed money)
  // LOST    — all bets settled, totalWin = 0
  // PAID    — agent paid the customer, receipt in proofKey
  // CANCELLED — draft voided before any bet attached
  status String @default("OPEN")

  totalStake Decimal @default(0) @db.Decimal(12, 2)
  totalWin   Decimal @default(0) @db.Decimal(12, 2)

  paidAt   DateTime?
  proofKey String? // S3 key of the payout receipt the agent uploads

  agent User        @relation(fields: [agentId], references: [id])
  bets  TicketBet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId, status])
  @@map("tickets")
}

// One BET Transaction attached to a Ticket. `gameRound` is the provider's round
// id from the callback payload — the WIN callback carries the same value, which
// is how a settling win finds its way back to the ticket.
model TicketBet {
  id            String  @id @default(cuid())
  ticketId      String
  transactionId String  @unique // the BET Transaction row (reference = serial_number)
  gameRound     String?
  // Provider game uid ("black:3oaks:1040", "nova:sports-betby:sports") — maps
  // to catalog gameID for display. NULL on old rows.
  gameId        String?
  // Raw provider payload extras (Gregmorn `info`, Silent `data`) — carries the
  // bet-slip detail (matches, odds, provider ticket id) for sportsbook bets.
  info          Json?
  betAmount     Decimal @db.Decimal(12, 2)
  winAmount     Decimal @default(0) @db.Decimal(12, 2)
  settled       Boolean @default(false)

  ticket      Ticket      @relation(fields: [ticketId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now())

  @@index([gameRound])
  @@map("ticket_bets")
}

// Public "Check Ticket" code for a PLAYER's sportsbook bet (the BET Transaction).
// Agent tickets already have an unguessable public code (Ticket.publicId,
// T-XXXXXX); players' bets only have the provider's sequential transaction
// number, which can't be public — counting it up would walk every player's
// bets. So each bet gets a random P-XXXXXXXX code, assigned the first time its
// owner views it, and that is the code anyone can check.
model TicketCheckCode {
  code          String      @id
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("ticket_check_codes")
}

// Octhera (aggregator) webhook log. Octhera runs the wallet for its games —
// player balances live there, funded in the Octhera portal — so these events
// are a RECORD of money that already moved on their side; they never touch
// User.balance. Keyed on (txnId, action): Octhera's docs say txnId is unique
// per event, but their withdrawal examples reuse one txnId across the
// requested / confirmed / rejected steps, so txnId alone could drop real ones.
model OctheraEvent {
  id        String   @id @default(cuid())
  txnId     String
  action    String // bet | win | bet_win | refund | deposit_required | withdraw_*
  username  String // the Octhera player id we registered (see providers/octhera.ts)
  betAmount Decimal  @db.Decimal(12, 2)
  winAmount Decimal  @db.Decimal(12, 2)
  amount    Decimal? @db.Decimal(12, 2) // withdrawal events only
  balance   Decimal  @db.Decimal(12, 2) // player's Octhera balance after the event
  currency  String
  gameRound String?
  gameUid   String?
  gameName  String?
  payload   Json // the full signed body, as received

  createdAt DateTime @default(now())

  @@unique([txnId, action])
  @@index([username, createdAt])
  @@map("octhera_events")
}

// Octhera API v2 wallet calls (debit / credit / rollback), one row per
// (type, txnId) — Octhera's idempotency key (a rollback reuses its debit's
// txnId). `response` is exactly what we answered, replayed on any retry.
// A rollback row with no applied debit is the "rollback before debit" marker
// that makes a late debit answer TXN_ROLLED_BACK. Money moves are also
// written as normal Transaction rows (reference "oc:<type>:<txnId>").
model OctheraWalletTxn {
  id        String  @id @default(cuid())
  type      String // debit | credit | rollback
  txnId     String
  playerId  String // = User.id (the playerId we launch with)
  action    String? // bet | bet_win | win | refund (rollback: null)
  betAmount Decimal @default(0) @db.Decimal(12, 2)
  winAmount Decimal @default(0) @db.Decimal(12, 2)
  applied   Boolean // true = money moved
  response  Json
  gameUid   String?
  gameRound String?
  payload   Json

  createdAt DateTime @default(now())

  @@unique([type, txnId])
  @@index([playerId, createdAt])
  @@map("octhera_wallet_txns")
}

// The site's game catalog, imported from Octhera (lib/catalog.ts). One row per
// Octhera game; `id` is the id the site and /api/games/launch use
// ("octhera:<gameUid>"). A game that leaves Octhera's list is deactivated,
// never deleted, so favorites, recent games and history keep resolving.
// `section` / `category` are derived from Octhera's `type` (lib/catalogClassify.ts).
model CatalogGame {
  id            String    @id
  source        String // "octhera"
  externalId    String // Octhera gameUid
  name          String
  providerCode  String // Octhera's `provider`
  providerName  String // Octhera's `providerName`
  providerSlug  String // our slug: /casino/<providerSlug>
  rawType       String // Octhera's `type`, as sent
  section       String // casino | sports | games
  category      String // slots | live | table | crash | fishing | lottery | arcade | sportsbook | virtual | esports | other
  img           String
  active        Boolean   @default(true)
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  deactivatedAt DateTime?

  @@unique([source, externalId])
  @@index([active, section, category])
  @@map("catalog_games")
}

// One row per catalog import run, so "is the whole catalog in?" has an answer.
model CatalogSync {
  id           String    @id @default(cuid())
  source       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  ok           Boolean   @default(false)
  complete     Boolean   @default(false) // every page fetched and `total` reached
  pages        Int       @default(0)
  total        Int? // Octhera's `total`, when sent
  fetched      Int       @default(0)
  added        Int       @default(0)
  updated      Int       @default(0)
  reactivated  Int       @default(0)
  deactivated  Int       @default(0)
  sections     Json? // { casino: { slots: 120, … }, games: {…}, sports: {…} }
  unknownTypes Json? // Octhera types we filed under games/other
  error        String?

  @@index([source, startedAt])
  @@map("catalog_syncs")
}

// Snapshots of a catalog before it was taken off the site. The pre-Octhera
// catalog (game_list/ files) is written here once, by the first import.
model CatalogBackup {
  id        String   @id @default(cuid())
  label     String
  source    String // e.g. "legacy:game_list"
  gameCount Int
  data      Json // [{ gameID, name, provider, img, hidden }]
  createdAt DateTime @default(now())

  @@map("catalog_backups")
}

// Provider GGR fee agreements (admin → Provider GGR). Append-only: a change
// is a new row with its own effective date, never an edit, so a period is
// always billed at the rate that was in force for it (src/lib/providerGgrCore).
// providerKey is "<integration>:<provider code>", or "<integration>:*" for the
// integration-wide default.
model ProviderFeeRate {
  id             String   @id @default(cuid())
  providerKey    String
  ratePct        Decimal  @db.Decimal(5, 2) // 0.00–100.00
  // net_floor | net_credit | per_round — how a negative-GGR period is treated
  negativePolicy String
  effectiveFrom  DateTime @db.Date // first day it applies, report timezone
  changedBy      String // admin username from the session
  note           String?
  createdAt      DateTime @default(now())

  @@index([providerKey, effectiveFrom])
  @@map("provider_fee_rates")
}

// Homepage promotions (admin → Homepage Promos), placed between game sections
// on the lobby. Shown only when switched on, inside their dates and complete
// (src/lib/homePromoCore.ts). Images live in object storage like ads.
model HomePromo {
  id             String    @id @default(cuid())
  title          String // internal name, admins only
  heading        String?
  description    String?
  imageKey       String? // desktop / default image
  mobileImageKey String? // optional narrow-screen image
  imageAlt       String?
  ctaLabel       String?
  destType       String    @default("internal") // internal | external
  destUrl        String?
  layout         String    @default("banner") // banner | poster
  slot           String    @default("after_first") // after_first | middle | lower
  pages          String[]  @default(["casino"]) // casino | live | games
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(false)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([slot, isActive])
  @@map("home_promos")
}
