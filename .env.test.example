# Copy to .env.test (gitignored) to run `npm run test:db`.
#
# The existing .env.example is stale and cannot be used to derive this — it is
# missing every AWS_*, VAPID_*, CRON_SECRET and ADMIN_USERNAME/PASSWORD, and
# still lists AGENT_SECRET, which nothing reads.

# ── The test database ────────────────────────────────────────────────────────
# A SECOND Railway Postgres, NOT the live one. The suite runs
# `prisma migrate reset`, which drops every table.
#
# tests/guard.ts refuses to run unless the database NAME contains a `test`
# token — call it vamos_test. It also refuses known production hosts and any
# URL identical to DATABASE_URL.
TEST_DATABASE_URL="postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/vamos_test"

# ── Secrets the routes read ──────────────────────────────────────────────────
# Any values work; tests only need them to be set and internally consistent.
AUTH_SECRET="test-auth-secret-not-used-in-production"
ADMIN_SECRET="test-admin-secret"
ADMIN_USERNAME="testadmin"
ADMIN_PASSWORD="testpassword"
PAYOUT_SECRET="test-payout-secret"

# HMAC key for /api/provider/wallet/callback — tests sign their own payloads.
SILENT_API_SECRET_KEY="test-silent-hmac-secret"
# Same for /api/provider/gregmorn/callback.
GREGMORN_SECRET_KEY="test-gregmorn-hmac-secret"

SMS_FORWARDER_SECRET="test-sms-forwarder-secret"
CRON_SECRET="test-cron-secret"

# ── Dummies that only need to EXIST ──────────────────────────────────────────
# src/lib/providers/silent-api.ts non-null-asserts these and calls
# axios.create() at module load, so importing anything that reaches it throws
# before a test runs unless they are set.
SILENT_API_BASE_URL="http://127.0.0.1:9/unused"
SILENT_API_BEARER_TOKEN="unused"

# ── Deliberately NOT set ─────────────────────────────────────────────────────
# REDIS_URL      — Vitest aliases src/lib/redis.ts to tests/fakeRedis.ts.
#                  (Playwright E2E DOES need a real Redis.)
# AWS_*          — storageConfigured() returns false and callers degrade
#                  gracefully, which is what we want to exercise.
# VAPID_*        — sendPushToUser() early-returns without them.
# DATABASE_URL   — never set here. tests/guard.ts assigns it from
#                  TEST_DATABASE_URL after validating it.
