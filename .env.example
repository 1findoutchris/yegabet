# Database
DATABASE_URL=""

# NextAuth
AUTH_SECRET=""
NEXTAUTH_URL=""

# Silent API — Game Provider
SILENT_API_BASE_URL=""
SILENT_API_BEARER_TOKEN=""
SILENT_API_SECRET_KEY=""

# App URLs
NEXT_PUBLIC_APP_URL=""
NEXT_PUBLIC_SOCKET_URL=""

# Redis — used for SMS-deposit matching
REDIS_URL=""

# SMS Forwarder secret — must match what the mphone agent app sends
SMS_FORWARDER_SECRET=""
# smsgate cloud (https://sms-gate.app) — outbound OTP for registration.
# Credentials from the smsgate app's Cloud Server settings.
SMSGATE_USERNAME=""
SMSGATE_PASSWORD=""
# Optional override; defaults to the smsgate cloud endpoint.
SMSGATE_URL=""
# Extra handsets: _2 … _5 (URL optional, falls back to SMSGATE_URL).

# AfroMessage (https://afromessage.com) — paid carrier, tried only after every
# enabled handset has failed. The API key alone is enough to switch it on;
# sender/identifier come from the AfroMessage dashboard and only affect the
# name recipients see. Appears in the admin OTP panel as "AfroMessage".
AFROMESSAGE_API_KEY=""
AFROMESSAGE_SENDER=""
AFROMESSAGE_FROM=""
# Optional override; defaults to https://api.afromessage.com/api/send
AFROMESSAGE_URL=""

# Emergency switch — "true" lets people register with NO phone verification.
# Signup only; password reset always requires a code. Welcome spin credits are
# still granted, but referral spin credits are withheld while this is on — OTP
# is what stops one referrer farming them with numbers they don't own.
OTP_DISABLED=""

# Admin dashboard — secret URL segment: /admin/<ADMIN_SECRET>
ADMIN_SECRET=""

# Cashier-agent portal (UAE cash desk) — /agent/<AGENT_SECRET>
AGENT_SECRET=""

# Payout-agent portal (settles ETB withdrawals) — /payout/<PAYOUT_SECRET>
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
PAYOUT_SECRET=""

# Payout-agent Telegram bot — pushes new withdrawal requests to the agent's chat.
# Token from @BotFather. Unset = the bot is simply off, nothing else breaks.
TELEGRAM_BOT_TOKEN=""
# Any random string; Telegram echoes it on every update so the webhook can
# reject anything it didn't send. Register the webhook once:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<NEXT_PUBLIC_APP_URL>/api/telegram/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_WEBHOOK_SECRET=""

# ── Phone verification channel ───────────────────────────────────────────────
# "telegram" verifies signups and password resets through the bot below instead
# of texting a code. Anything else (including unset) keeps the SMS rail above,
# so this is also the rollback: unset it and SMS resumes with no code change.
#
# On the Telegram rail the user shares their contact with the bot, and Telegram
# itself vouches for the number — the same proof of ownership SMS gave, minus
# the per-message cost. Users with no Telegram account cannot sign up OR reset
# their password while this is on.
AUTH_OTP_CHANNEL=""

# A SECOND bot from @BotFather, separate from the payout one above: that bot
# runs an agent login state machine and one chat can't be in both flows.
# Both values are required — a token without the username builds a dead link,
# and the send endpoint falls back to SMS unless it has both.
TELEGRAM_VERIFY_BOT_TOKEN=""
# Without the leading @, e.g. VinnaVerifyBot
TELEGRAM_VERIFY_BOT_USERNAME=""
# Its own webhook secret. Register it once:
#   curl "https://api.telegram.org/bot<TELEGRAM_VERIFY_BOT_TOKEN>/setWebhook?url=<NEXT_PUBLIC_APP_URL>/api/telegram/verify&secret_token=<TELEGRAM_VERIFY_WEBHOOK_SECRET>"
TELEGRAM_VERIFY_WEBHOOK_SECRET=""

# Set only while migrating between Silent API accounts: the callback accepts
# this as a second valid signing key so in-flight rounds from the old account
# still settle. Unset it once those have drained.
SILENT_API_SECRET_KEY_PREVIOUS=

# ── Railway deployment ───────────────────────────────────────────────────────
# Railway injects PORT automatically — `next start` honors it, nothing to set.
#
# Add the Postgres + Redis plugins to the Railway project, then reference their
# connection strings instead of pasting values:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
#   REDIS_URL    = ${{Redis.REDIS_URL}}
#
# Public URL — set after the service gets its domain (or your custom domain):
#   NEXT_PUBLIC_APP_URL = https://${{RAILWAY_PUBLIC_DOMAIN}}  (or https://yourdomain.com)
#   NEXTAUTH_URL        = same value
#
# Migrations don't run on deploy — set the Railway start command to:
#   npx prisma migrate deploy && npm run start
# (or add a release-phase command running `npx prisma migrate deploy`).

# Admin login credentials (the /admin/<ADMIN_SECRET> panel signs in with these)
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Silent API kill-switch — REAL game launches bill the operator account.
# Leave unset/false until the callback URL + IP whitelist are configured in the
# provider dashboard. "true" = live money moves.
SILENT_API_LIVE=""

# S3-compatible storage — withdrawal proofs + ticket payout receipts.
# Without these, uploads fall back to local disk (.uploads/) which is NOT
# persistent on Railway — files vanish on every redeploy. Use Railway Volumes,
# Cloudflare R2, or AWS S3 for production.
AWS_S3_BUCKET_NAME=""
AWS_ENDPOINT_URL=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION=""

# Cron routes (/api/cron/proof-cleanup, /api/cron/agent-commission) — any random
# string; callers must send it as Authorization: Bearer <CRON_SECRET>.
# Schedule with Railway cron or an external pinger (cron-job.org etc).
CRON_SECRET=""

# Web push notifications — generate a VAPID keypair once:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# mailto: or https: contact embedded in push requests
VAPID_SUBJECT=""

# Google Search Console verification token (optional — SEO)
GOOGLE_SITE_VERIFICATION=""
