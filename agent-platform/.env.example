# Copy to .env for local development. Never commit real values.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL — required.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_platform_dev

# Redis — optional until the first background job (Task 06).
REDIS_URL=

# Brand (CLAUDE.md §2: config, never hardcoded). Decided 2026-10-19: YegaBet, yega.bet.
PLATFORM_NAME=YegaBet
PLATFORM_DOMAIN=yega.bet

# Phone number protection (CLAUDE.md §7) — required. 32 random bytes each, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back these up: losing PHONE_ENC_KEY loses phone display; changing PHONE_HASH_KEY breaks login lookups.
PHONE_HASH_KEY=
PHONE_ENC_KEY=

# Telegram bot (plan 04): a NEW bot from @BotFather, for the agent platform only.
# Without these the app still runs; login and the webhook answer 503.
TELEGRAM_BOT_TOKEN=
# Without the @, e.g. YegaBetAgentBot
TELEGRAM_BOT_USERNAME=
# Random, 16-256 chars of A-Z a-z 0-9 _ -. Telegram echoes it on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Mini App address (the [Open YegaBet] button). Leave empty until the Mini App exists.
WEBAPP_URL=
# Website, for [Continue on website]. Defaults to https://<PLATFORM_DOMAIN>.
PUBLIC_WEB_URL=
# Session lifetime in hours (Q-24: 12).
SESSION_TTL_HOURS=12
# Then, in the Railway console:  npm run telegram:setup   and   npm run staff:add -- --telegram-id <id> --name <name> --role owner
