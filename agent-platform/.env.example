# Copy to .env for local development. Never commit real values.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL — required.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_platform_dev

# Redis — optional until the first background job (Task 06).
REDIS_URL=

# Brand placeholders (CLAUDE.md §2: name and domain undecided — never hardcode).
PLATFORM_NAME=Platform
PLATFORM_DOMAIN=example.com
