# Copy to .env for local development. Never commit real values.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL — required.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_platform_dev

# Redis — optional until the first background job (Task 06).
REDIS_URL=

# Brand (CLAUDE.md §2: config, never hardcoded). Decided 2026-10-19: YegaBet, yega.bet.
PLATFORM_NAME=YegaBet
PLATFORM_DOMAIN=yega.bet
