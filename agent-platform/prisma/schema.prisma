// Schema changes go through migrations only (CLAUDE.md §4). Triggers that
// Prisma can't express live as raw SQL inside the migration files.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Dated, append-only config: the value in force at time T is the row with the
// greatest effective_from <= T. A trigger blocks UPDATE/DELETE.
model ConfigVersion {
  id            BigInt   @id @default(autoincrement())
  key           String
  value         Json
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(6)
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([key, effectiveFrom])
  @@map("config_versions")
}

// Unfinished-but-deployed features stay dark: an absent row means off.
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedBy String   @map("updated_by")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

// ── Ledger (CLAUDE.md §5.1) ──────────────────────────────────────────────────

model Account {
  id            BigInt   @id @default(autoincrement())
  type          String
  ownerKind     String   @map("owner_kind")
  ownerId       String   @map("owner_id")
  currency      String   @default("ETB") @db.Char(3)
  allowNegative Boolean  @map("allow_negative")
  isTest        Boolean  @default(false) @map("is_test")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  balance AccountBalance?
  debits  LedgerEntry[]   @relation("debit")
  credits LedgerEntry[]   @relation("credit")

  @@unique([type, ownerKind, ownerId, currency])
  @@map("accounts")
}

// Cache of Σcredits − Σdebits. Writable only inside a ledger posting
// (a trigger checks the transaction-local setting ledger.posting = 'on').
model AccountBalance {
  accountId BigInt   @id @map("account_id")
  balance   BigInt   @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("account_balances")
}

// Journal header: one per posting; owns the idempotency key for the whole set.
model LedgerTransaction {
  id                    BigInt   @id @default(autoincrement())
  idempotencyKey        String   @unique @map("idempotency_key")
  requestHash           String   @map("request_hash")
  reason                String
  referenceId           String?  @map("reference_id")
  reversesTransactionId BigInt?  @unique @map("reverses_transaction_id")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reverses        LedgerTransaction? @relation("reversal", fields: [reversesTransactionId], references: [id], onDelete: Restrict)
  reversedBy      LedgerTransaction? @relation("reversal")
  entries         LedgerEntry[]
  deposit         Deposit?
  withdrawalHold  Withdrawal?        @relation("hold")
  withdrawalFinal Withdrawal?        @relation("final")
  providerCalls   ProviderCall[]
  settlementLines SettlementLine[]

  @@map("ledger_transactions")
}

model LedgerEntry {
  id              BigInt   @id @default(autoincrement())
  transactionId   BigInt   @map("transaction_id")
  debitAccountId  BigInt   @map("debit_account_id")
  creditAccountId BigInt   @map("credit_account_id")
  amount          BigInt
  currency        String   @db.Char(3)
  reason          String
  referenceId     String?  @map("reference_id")
  idempotencyKey  String   @unique @map("idempotency_key")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  debitAccount  Account           @relation("debit", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount Account           @relation("credit", fields: [creditAccountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([debitAccountId])
  @@index([creditAccountId])
  @@map("ledger_entries")
}

// ── Users, agents, roles (CLAUDE.md §5.2, plan 03) ───────────────────────────
// Triggers (in 0003_users): the DB computes ancestors/depth from the parent,
// refuses any later change to the hierarchy, and never deletes an agent.
// Partial unique indexes Prisma can't express: one company agent, and one
// current assignment per player.

model Agent {
  id          BigInt   @id @default(autoincrement())
  slug        String   @unique
  displayName String   @map("display_name")
  parentId    BigInt?  @map("parent_id")
  ancestors   BigInt[] @default([])
  depth       Int      @default(0)
  isCompany   Boolean  @default(false) @map("is_company")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  parent          Agent?                @relation("tree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children        Agent[]               @relation("tree")
  players         Player[]
  assignments     AgentAssignment[]
  members         AgentMember[]
  paymentAccounts AgentPaymentAccount[]
  deposits        Deposit[]
  withdrawals     Withdrawal[]
  bets            Bet[]
  settlementLines SettlementLine[]

  @@index([parentId])
  @@index([ancestors], type: Gin)
  @@map("agents")
}

model Player {
  id             BigInt    @id @default(autoincrement())
  phoneHash      String    @unique @map("phone_hash")
  phoneEnc       String    @map("phone_enc")
  telegramUserId String?   @unique @map("telegram_user_id")
  agentId        BigInt    @map("agent_id")
  status         String    @default("active")
  ageConfirmedAt DateTime? @map("age_confirmed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agent       Agent             @relation(fields: [agentId], references: [id], onDelete: Restrict)
  assignments AgentAssignment[]
  webSignups  WebSignup[]
  deposits    Deposit[]
  withdrawals Withdrawal[]
  bets        Bet[]

  @@index([agentId])
  @@map("players")
}

model AgentAssignment {
  id            BigInt    @id @default(autoincrement())
  playerId      BigInt    @map("player_id")
  agentId       BigInt    @map("agent_id")
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)
  reason        String

  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([playerId])
  @@index([agentId])
  @@map("agent_assignments")
}

model Staff {
  id             BigInt   @id @default(autoincrement())
  displayName    String   @map("display_name")
  telegramUserId String?  @unique @map("telegram_user_id")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles StaffRole[]

  @@map("staff")
}

model Role {
  key   String      @id
  staff StaffRole[]

  @@map("roles")
}

model StaffRole {
  staffId   BigInt   @map("staff_id")
  roleKey   String   @map("role_key")
  grantedBy String   @map("granted_by")
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)
  role  Role  @relation(fields: [roleKey], references: [key], onDelete: Restrict)

  @@id([staffId, roleKey])
  @@map("staff_roles")
}

model AgentMember {
  id             BigInt   @id @default(autoincrement())
  agentId        BigInt   @map("agent_id")
  displayName    String   @map("display_name")
  telegramUserId String?  @unique @map("telegram_user_id")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([agentId])
  @@map("agent_members")
}

// ── Auth (plan 04) ───────────────────────────────────────────────────────────

// Only the sha256 of a session token is stored.
model Session {
  id            BigInt    @id @default(autoincrement())
  tokenHash     String    @unique @map("token_hash")
  principalKind String    @map("principal_kind")
  principalId   BigInt    @map("principal_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  ip            String?
  userAgent     String?   @map("user_agent")

  @@index([principalKind, principalId], map: "sessions_principal_idx")
  @@map("sessions")
}

model SignupIntent {
  telegramUserId String    @id @map("telegram_user_id")
  referralSlug   String?   @map("referral_slug")
  webCodeHash    String?   @map("web_code_hash")
  ageConfirmedAt DateTime? @map("age_confirmed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)

  @@map("signup_intents")
}

model WebSignup {
  codeHash     String    @id @map("code_hash")
  referralSlug String?   @map("referral_slug")
  playerId     BigInt?   @map("player_id")
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)

  player Player? @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@map("web_signups")
}

// Append-only (trigger). Never contains phone numbers or tokens.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now()) @db.Timestamptz(6)
  actorKind String?  @map("actor_kind")
  actorId   String?  @map("actor_id")
  action    String
  target    String?
  before    Json?
  after     Json?
  ip        String?

  @@index([at])
  @@index([action])
  @@map("audit_log")
}

// ── Deposits (plan 05) ───────────────────────────────────────────────────────

model AgentPaymentAccount {
  id            BigInt   @id @default(autoincrement())
  agentId       BigInt   @map("agent_id")
  method        String
  accountName   String   @map("account_name")
  accountNumber String   @map("account_number")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Restrict)
  deposits Deposit[]

  @@unique([method, accountNumber])
  @@index([agentId])
  @@map("agent_payment_accounts")
}

// Decided once (trigger): pending → confirmed | rejected | expired.
model Deposit {
  id                  BigInt    @id @default(autoincrement())
  playerId            BigInt    @map("player_id")
  agentId             BigInt    @map("agent_id")
  paymentAccountId    BigInt    @map("payment_account_id")
  method              String
  amount              BigInt
  referenceHash       String    @map("reference_hash")
  referenceEnc        String    @map("reference_enc")
  status              String    @default("pending")
  decidedByKind       String?   @map("decided_by_kind")
  decidedById         String?   @map("decided_by_id")
  decisionReason      String?   @map("decision_reason")
  decidedAt           DateTime? @map("decided_at") @db.Timestamptz(6)
  ledgerTransactionId BigInt?   @unique @map("ledger_transaction_id")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  player            Player              @relation(fields: [playerId], references: [id], onDelete: Restrict)
  agent             Agent               @relation(fields: [agentId], references: [id], onDelete: Restrict)
  paymentAccount    AgentPaymentAccount @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)
  ledgerTransaction LedgerTransaction?  @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)

  @@unique([method, referenceHash])
  @@index([agentId, status])
  @@index([playerId, createdAt])
  @@map("deposits")
}

// ── Withdrawals (plan 06) ────────────────────────────────────────────────────
// Status moves are enforced by a trigger (0006_withdrawals).

model Withdrawal {
  id                 BigInt    @id @default(autoincrement())
  playerId           BigInt    @map("player_id")
  agentId            BigInt    @map("agent_id")
  method             String
  amount             BigInt
  status             String    @default("requested")
  paidReferenceHash  String?   @map("paid_reference_hash")
  paidReferenceEnc   String?   @map("paid_reference_enc")
  paidAt             DateTime? @map("paid_at") @db.Timestamptz(6)
  paidByKind         String?   @map("paid_by_kind")
  paidById           String?   @map("paid_by_id")
  holdTransactionId  BigInt    @unique @map("hold_transaction_id")
  finalTransactionId BigInt?   @unique @map("final_transaction_id")
  closedByKind       String?   @map("closed_by_kind")
  closedById         String?   @map("closed_by_id")
  closeReason        String?   @map("close_reason")
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(6)
  slaDueAt           DateTime  @map("sla_due_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  player           Player             @relation(fields: [playerId], references: [id], onDelete: Restrict)
  agent            Agent              @relation(fields: [agentId], references: [id], onDelete: Restrict)
  holdTransaction  LedgerTransaction  @relation("hold", fields: [holdTransactionId], references: [id], onDelete: Restrict)
  finalTransaction LedgerTransaction? @relation("final", fields: [finalTransactionId], references: [id], onDelete: Restrict)

  @@unique([method, paidReferenceHash])
  @@index([agentId, status])
  @@index([playerId, createdAt])
  @@index([status, slaDueAt])
  @@map("withdrawals")
}

// ── Providers, bets, games (plan 07) ─────────────────────────────────────────

model Provider {
  id     String  @id
  name   String
  active Boolean @default(true)

  calls ProviderCall[]
  bets  Bet[]
  games Game[]

  @@map("providers")
}

// One row per (provider, type, txn_id); the stored response is replayed on retries.
model ProviderCall {
  id                  BigInt   @id @default(autoincrement())
  providerId          String   @map("provider_id")
  type                String
  txnId               String   @map("txn_id")
  playerId            BigInt?  @map("player_id")
  action              String?
  gameUid             String?  @map("game_uid")
  gameRound           String?  @map("game_round")
  betAmount           BigInt   @default(0) @map("bet_amount")
  winAmount           BigInt   @default(0) @map("win_amount")
  applied             Boolean
  response            Json
  payload             Json
  ledgerTransactionId BigInt?  @map("ledger_transaction_id")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  provider          Provider           @relation(fields: [providerId], references: [id], onDelete: Restrict)
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)

  @@unique([providerId, type, txnId])
  @@index([providerId, playerId, gameRound], map: "provider_calls_round_idx")
  @@map("provider_calls")
}

// §5.6: agent_id is the snapshot at bet time; settlement (Task 10) reads this.
model Bet {
  id         BigInt    @id @default(autoincrement())
  providerId String    @map("provider_id")
  playerId   BigInt    @map("player_id")
  agentId    BigInt    @map("agent_id")
  gameUid    String?   @map("game_uid")
  gameRound  String?   @map("game_round")
  debitTxnId String    @map("debit_txn_id")
  stake      BigInt
  win        BigInt    @default(0)
  status     String    @default("open")
  placedAt   DateTime  @default(now()) @map("placed_at") @db.Timestamptz(6)
  settledAt  DateTime? @map("settled_at") @db.Timestamptz(6)

  provider           Provider            @relation(fields: [providerId], references: [id], onDelete: Restrict)
  player             Player              @relation(fields: [playerId], references: [id], onDelete: Restrict)
  agent              Agent               @relation(fields: [agentId], references: [id], onDelete: Restrict)
  settlementCounteds SettlementCounted[]

  @@unique([providerId, debitTxnId])
  @@index([playerId, status])
  @@index([agentId, providerId, settledAt], map: "bets_agent_settlement_idx")
  @@index([providerId, playerId, gameRound], map: "bets_round_idx")
  @@index([status, placedAt])
  @@map("bets")
}

model Game {
  providerId   String   @map("provider_id")
  gameUid      String   @map("game_uid")
  name         String
  providerName String?  @map("provider_name")
  type         String?
  img          String?
  active       Boolean  @default(true)
  section      String   @default("games")
  category     String   @default("other")
  providerSlug String?  @map("provider_slug")
  firstSeenAt  DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  syncedAt     DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@id([providerId, gameUid])
  @@index([active, type])
  @@index([active, section, category], map: "games_active_section_category_idx")
  @@index([providerSlug], map: "games_provider_slug_idx")
  @@map("games")
}

// ── Settlement (plan 10) ─────────────────────────────────────────────────────
// Triggers (0008_settlement): approved periods and their lines are frozen.

model SettlementPeriod {
  id             BigInt    @id @default(autoincrement())
  startsAt       DateTime  @unique @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime  @map("ends_at") @db.Timestamptz(6)
  status         String    @default("open")
  config         Json?
  draftedAt      DateTime? @map("drafted_at") @db.Timestamptz(6)
  approvedByKind String?   @map("approved_by_kind")
  approvedById   String?   @map("approved_by_id")
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  lines   SettlementLine[]
  counted SettlementCounted[]

  @@map("settlement_periods")
}

model SettlementLine {
  id                  BigInt  @id @default(autoincrement())
  periodId            BigInt  @map("period_id")
  agentId             BigInt  @map("agent_id")
  providerId          String  @map("provider_id")
  stakes              BigInt
  winnings            BigInt
  fees                BigInt
  result              BigInt
  beneficiary         String
  beneficiaryAgentId  BigInt? @map("beneficiary_agent_id")
  parentLevel         Int?    @map("parent_level")
  amount              BigInt
  ledgerTransactionId BigInt? @map("ledger_transaction_id")

  period            SettlementPeriod   @relation(fields: [periodId], references: [id], onDelete: Restrict)
  agent             Agent              @relation(fields: [agentId], references: [id], onDelete: Restrict)
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)

  @@index([periodId, agentId], map: "settlement_lines_period_agent_idx")
  @@map("settlement_lines")
}

model SettlementCounted {
  betId    BigInt @id @map("bet_id")
  stake    BigInt
  win      BigInt
  periodId BigInt @map("period_id")

  bet    Bet              @relation(fields: [betId], references: [id], onDelete: Restrict)
  period SettlementPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@map("settlement_counted")
}
