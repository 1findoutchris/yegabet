<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Xcode signs App Store builds with the
	     production APNs environment from the distribution profile. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links: https://vinna.bet/... opens the app. Served by
	     src/app/.well-known/apple-app-site-association/route.ts. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:vinna.bet</string>
		<string>applinks:www.vinna.bet</string>
	</array>
</dict>
</plist>
