# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the templates must be committed. Without these negations `.env*`
# swallowed them, which is why .env.example was never in the repo.
!.env.example
!.env.test.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright SMS sink scratch file
tests/e2e/.sms-sink.json

# Playwright output
test-results/
playwright-report/

# dev logs
*.log

# bootstrap spec — contains live-looking provider credentials
vamos-bet-claude-code-prompt.md
.uploads/
